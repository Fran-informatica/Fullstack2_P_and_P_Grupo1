# Copiar este archivo como .env y completar los valores. .env no se sube a Git.

# Conexión a PostgreSQL (la base se crea sola al iniciar la API si el usuario tiene permiso)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=pixel_play

# Puerto de la API. Si se cambia, indicar la misma dirección en API_URL de web/.env
API_PORT=3001

# Opcional: habilita crear, modificar y eliminar productos vía API (Authorization: Bearer <token>).
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
